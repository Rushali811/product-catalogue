# ---- Server ----
PORT=3001
HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS (frontend URL in dev)
CORS_ORIGIN=http://localhost:5173

# ---- Product data source ----
# Base URL of the upstream product API (swap to anything that implements the same shape).
FAKE_STORE_API_URL=https://fakestoreapi.com
# How long to cache product data in memory, in milliseconds.
PRODUCT_CACHE_TTL_MS=60000
# Comma-separated list of product IDs treated as "top rated" (entrepreneur-curated).
FEATURED_PRODUCT_IDS=1,2,4,5,8

# ---- Email (SMTP) ----
# In dev this points at MailHog (started by docker-compose). In prod you'd swap to SES, etc.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# MailHog does not require auth. Leave blank in dev.
SMTP_USER=
SMTP_PASS=
# Sender + sales inbox addresses used by the enquiry route.
EMAIL_FROM="Product Catalogue <no-reply@example.com>"
SALES_INBOX=sales@example.com
